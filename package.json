  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "esbuild": "0.25.0",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.13.1",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.71.0"
  }
}
