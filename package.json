{
  "name": "autonatic",
  "version": "1.7.13",
  "description": "Transform raw text into structured Obsidian notes using your choice of AI provider.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "node tests/run-tests.mjs",
    "typecheck": "tsc",
    "lint": "eslint src",
    "check": "npm run test && npm run typecheck"
  },
  "keywords": [
